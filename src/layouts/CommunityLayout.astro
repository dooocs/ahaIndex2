---
import BaseLayout from './BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import { community } from '../lib/community-config';
import { SITE_NAME, siteTitle } from '../lib/site';
import '../styles/community.css';
interface Props { title: string; }
const { title } = Astro.props;
---
<BaseLayout title={siteTitle(title)} canonicalUrl={`https://www.amazingindex.com${Astro.url.pathname}`} noindex analytics={false}>
  <div class="community-page">
  <Masthead showScore={false} />
  <main class="community" data-community>
    {community ? <slot /> : <section class="community-empty"><h1>相亲栏目筹备中</h1><p>暂未开放注册与发布。</p><a href="/" data-astro-reload>返回首页</a></section>}
    <noscript>此栏目需要启用 JavaScript 才能登录和加载帖子。</noscript>
  </main>
  <footer class="community-footer"><span>© {new Date().getFullYear()} {SITE_NAME}</span><nav aria-label="页脚"><a href="/about" data-astro-reload>关于本站</a><a href="/privacy" data-astro-reload>隐私政策</a><a href="/terms" data-astro-reload>服务条款</a><a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">浙ICP备2022023772号</a></nav></footer>
  </div>
  <script src="../scripts/community.ts"></script>
</BaseLayout>
