---
import { ClientRouter } from 'astro:transitions';
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/archive.css';
import '../styles/projects.css';
import { SITE_NAME, SITE_SLOGAN, SITE_DESCRIPTION, DAILY_NAME, DAILY_TAGLINE, SITE_URL } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogType?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogUrl?: string;
  ogImage?: string;
  jsonLd?: Record<string, any>;
  noindex?: boolean;
  analytics?: boolean;
}

const {
  title = `${SITE_NAME} · ${SITE_SLOGAN}`,
  description = SITE_DESCRIPTION,
  canonicalUrl = `${SITE_URL}/`,
  ogType = 'website',
  ogTitle: ogTitleProp,
  ogDescription: ogDescriptionProp,
  ogUrl: ogUrlProp,
  ogImage = `${SITE_URL}/og/amazingindex-og.jpg`,
  jsonLd,
  noindex = false,
  analytics = true,
} = Astro.props;

// Social cards follow the page's own title/description unless a page overrides them.
const ogTitle = ogTitleProp ?? title;
const ogDescription = ogDescriptionProp ?? description;
const ogUrl = ogUrlProp ?? canonicalUrl;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="keywords" content={`${SITE_NAME}, ${DAILY_NAME}, AI日报, AI简报, 人工智能, AI行业动态`} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title={`${DAILY_NAME} ${DAILY_TAGLINE} RSS`} href="/rss.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content={SITE_NAME} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />

    {jsonLd && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": SITE_NAME,
      "alternateName": DAILY_NAME,
      "url": SITE_URL,
      "description": SITE_DESCRIPTION,
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://www.amazingindex.com/?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    })} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {analytics && <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HXX784QFN0"></script>}
    {analytics && <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-HXX784QFN0');
    </script>}

    <ClientRouter />
  </head>
  <body>
    <slot />
    {analytics && <script src="../scripts/tracking.ts"></script>}
  </body>
</html>
