---
// Keep the text game's styles and keyboard handlers inside its own document,
// while sharing the same masthead as 梦想人生 and 西湖飞车. No navigation tab yet.
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import { SITE_URL, siteTitle } from '../lib/site';
const canonical = `${SITE_URL}/dark-room`;
---
<BaseLayout title={siteTitle('小黑屋')} description="从一间寒冷的小黑屋开始，生火、建造、探索。" canonicalUrl={canonical} ogUrl={canonical} noindex>
  <Masthead showScore={false} overlay />
  <main class="dark-room-page">
    <h1 class="sr-only">小黑屋</h1>
    <iframe id="dark-room-app" src="/dark-room/app.html?v=20261104-layout" title="小黑屋 · 文字冒险" allow="autoplay; fullscreen"></iframe>
    <noscript><p>小黑屋需要开启 JavaScript 才能游玩。</p></noscript>
  </main>
</BaseLayout>
<style>
  :global(html:has(.dark-room-page)), :global(body:has(.dark-room-page)) { overflow: hidden; scrollbar-gutter: auto; }
  :global(body:has(.dark-room-page)) {
    --dark-room-bg: #fff; --dark-room-ink: #1a1612; --dark-room-muted: #777;
    --ink: var(--dark-room-ink); --muted: var(--dark-room-muted);
    background: var(--dark-room-bg);
  }
  :global(body:has(.dark-room-page[data-theme="dark"])) {
    --dark-room-bg: #272823; --dark-room-ink: #eee; --dark-room-muted: #aaa;
  }
  :global(body:has(.dark-room-page)::before) { display: none; }
  :global(body:has(.dark-room-page) .masthead),
  :global(body:has(.dark-room-page) .masthead .nav-bar) {
    background: var(--dark-room-bg); box-shadow: none;
  }
  :global(body:has(.dark-room-page) .masthead .logo-text) { color: var(--dark-room-ink); }
  :global(body:has(.dark-room-page) .masthead-tagline),
  :global(body:has(.dark-room-page) .masthead-subtitle),
  :global(body:has(.dark-room-page) .masthead-vol) { color: var(--dark-room-muted); }
  :global(body:has(.dark-room-page[data-theme="dark"]) .masthead .logo-icon path:last-child) { fill: #eee; }
  .dark-room-page { margin: 0; padding: 0; }
  iframe { position: fixed; top: var(--game-top, 180px); left: 0; width: 100%; height: calc(100dvh - var(--game-top, 180px)); border: 0; background: var(--dark-room-bg); }
  noscript { position: relative; z-index: 11; display: block; padding: 200px 24px 48px; text-align: center; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
</style>
<script is:inline>
  (() => {
    const frame = document.getElementById('dark-room-app');
    const head = document.querySelector('.masthead');
    if (!frame || !head) return;
    const page = document.querySelector('.dark-room-page');
    const setTheme = (dark) => { page.dataset.theme = dark ? 'dark' : 'light'; };
    // Match the saved theme before the iframe finishes loading, then follow
    // the game's actual computed background (including subsequent light toggles).
    try { setTheme(Boolean(JSON.parse(localStorage.getItem('amazingindex.dark-room.gameState'))?.config?.lightsOff)); } catch (_) {}
    const syncTheme = () => {
      const body = frame.contentDocument?.body;
      if (body) setTheme(frame.contentWindow.getComputedStyle(body).backgroundColor === 'rgb(39, 40, 35)');
    };
    const ready = () => {
      syncTheme();
      const doc = frame.contentDocument;
      doc?.addEventListener('load', syncTheme, true);
      doc?.addEventListener('click', () => requestAnimationFrame(syncTheme));
      frame.contentWindow?.focus();
    };
    const params = new URLSearchParams(location.search);
    const src = new URL(frame.src);
    for (const key of ['lang', 'ignorebrowser']) {
      if (params.has(key)) src.searchParams.set(key, params.get(key));
    }
    if (src.href !== frame.src) frame.src = src.href;
    const resize = () => frame.style.setProperty('--game-top', `${Math.ceil(head.getBoundingClientRect().bottom)}px`);
    resize();
    if (window.ResizeObserver) new ResizeObserver(resize).observe(head);
    window.addEventListener('resize', resize);
    frame.addEventListener('load', ready);
    if (frame.contentDocument?.readyState === 'complete' && frame.contentDocument.URL !== 'about:blank') ready();
  })();
</script>
