---
// Keep the text game's styles and keyboard handlers inside its own document,
// while sharing the same masthead and navigation as 梦想人生 and 西湖飞车.
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import { SITE_URL, siteTitle } from '../lib/site';
const canonical = `${SITE_URL}/dark-room`;
---
<BaseLayout title={siteTitle('小黑屋')} description="从一间寒冷的小黑屋开始，生火、建造、探索。" canonicalUrl={canonical} ogUrl={canonical} noindex>
  <Masthead showScore={false} overlay />
  <link rel="stylesheet" href="/dark-room/css/settings.css?v=20261108-sound-toggle" />
  <main class="dark-room-page">
    <h1 class="sr-only">小黑屋</h1>
    <div class="dark-room-cloud" aria-label="游戏存档">
      <span id="dark-room-save-status" role="status" aria-live="polite">正在准备存档…</span>
      <a id="dark-room-login" href="/login?next=%2Fdark-room" data-astro-reload>登录同步</a>
      <button id="dark-room-save" type="button" disabled>手动保存</button>
      <button id="dark-room-load" type="button" disabled>读档</button>
      <button id="dark-room-retry" type="button" hidden>重试</button>
      <span id="dark-room-settings-host"></span>
    </div>
    <p id="dark-room-start-note">正在准备存档…</p>
    <dialog id="dark-room-saves" aria-label="小黑屋存档"></dialog>
    <iframe id="dark-room-app" src="/dark-room/app.html?v=20261108-sound-toggle&amp;embedded=1" title="小黑屋 · 文字冒险" allow="autoplay; fullscreen"></iframe>
    <noscript><p>小黑屋需要开启 JavaScript 才能游玩。</p></noscript>
  </main>
</BaseLayout>
<style>
  :global(html:has(.dark-room-page)), :global(body:has(.dark-room-page)) { overflow: hidden; scrollbar-gutter: auto; }
  :global(body:has(.dark-room-page)) {
    --dark-room-bg: #fff; --dark-room-ink: #1a1612; --dark-room-muted: #777;
    --ink: var(--dark-room-ink); --muted: var(--dark-room-muted);
    background: var(--dark-room-bg);
  }
  :global(body:has(.dark-room-page[data-theme="dark"])) {
    --dark-room-bg: #272823; --dark-room-ink: #eee; --dark-room-muted: #aaa;
  }
  :global(body:has(.dark-room-page)::before) { display: none; }
  :global(body:has(.dark-room-page) .masthead),
  :global(body:has(.dark-room-page) .masthead .nav-bar) {
    background: var(--dark-room-bg); box-shadow: none;
  }
  :global(body:has(.dark-room-page) .masthead .logo-text) { color: var(--dark-room-ink); }
  :global(body:has(.dark-room-page) .masthead-tagline),
  :global(body:has(.dark-room-page) .masthead-subtitle),
  :global(body:has(.dark-room-page) .masthead-vol) { color: var(--dark-room-muted); }
  :global(body:has(.dark-room-page[data-theme="dark"]) .masthead .logo-icon path:last-child) { fill: #eee; }
  .dark-room-page { margin: 0; padding: 0; }
  .dark-room-cloud { position: fixed; top: calc(var(--game-top, 180px) + 8px); right: var(--game-controls-right, 32px); max-width: calc(100vw - 32px); z-index: 16; display: flex; align-items: center; gap: 12px; color: var(--dark-room-muted); font: 12px/1.6 system-ui, sans-serif; }
  .dark-room-cloud > button, .dark-room-cloud > a { border: 0; background: transparent; color: var(--dark-room-ink); font: inherit; padding: 7px 2px; cursor: pointer; white-space: nowrap; }
  .dark-room-cloud > button:disabled { opacity: .4; cursor: default; }
  .dark-room-cloud > button:focus-visible, .dark-room-cloud > a:focus-visible { outline: 2px solid #d0461e; outline-offset: 3px; }
  #dark-room-settings-host { min-width: 28px; flex-shrink: 0; color: var(--dark-room-ink); }
  [hidden] { display: none !important; }
  #dark-room-start-note { position: fixed; top: calc(var(--game-top, 180px) + 100px); left: 24px; right: 24px; z-index: 12; text-align: center; color: var(--dark-room-muted); font-size: 14px; }
  dialog { box-sizing: border-box; width: min(468px, calc(100vw - 32px)); max-height: 75dvh; overflow-y: auto; padding: 0; border: 1px solid var(--dark-room-muted); border-radius: 8px; background: var(--dark-room-bg); color: var(--dark-room-ink); font: 14px/1.6 system-ui, sans-serif; }
  dialog::backdrop { background: #0006; }
  dialog :global(h2) { margin: 0 0 10px; font-size: 18px; }
  dialog :global(p) { margin: 0 0 16px; color: var(--dark-room-muted); }
  dialog :global(button) { display: block; width: 100%; margin-top: 8px; padding: 12px; text-align: left; border: 1px solid color-mix(in srgb, var(--dark-room-muted) 40%, transparent); border-radius: 4px; color: inherit; background: transparent; font: inherit; cursor: pointer; }
  dialog :global(button:hover), dialog :global(button:focus-visible) { border-color: currentColor; }
  dialog :global(button strong), dialog :global(button span) { display: block; }
  dialog :global(button span) { margin-top: 3px; font-size: 12px; color: var(--dark-room-muted); }
  dialog :global(.dark-room-dialog-header) { position: sticky; top: 0; z-index: 1; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 16px 24px; background: var(--dark-room-bg); border-bottom: 1px solid color-mix(in srgb, var(--dark-room-muted) 30%, transparent); }
  dialog :global(.dark-room-dialog-header h2) { margin: 0; }
  dialog :global(.dark-room-dialog-body) { padding: 20px 24px 24px; }
  dialog :global(.dark-room-dialog-close) { flex-shrink: 0; width: auto; min-width: 100px; min-height: 48px; margin: 0; padding: 8px 14px; text-align: center; white-space: nowrap; font-size: 18px; font-weight: 600; background: color-mix(in srgb, var(--dark-room-ink) 8%, var(--dark-room-bg)); border-color: var(--dark-room-muted); }
  dialog :global(.dark-room-dialog-close:focus-visible) { outline: 2px solid var(--dark-room-ink); outline-offset: 3px; }
  #dark-room-save-status { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  @media (max-width: 768px) { .dark-room-cloud { left: 16px; gap: 8px; } #dark-room-save-status { flex: 1; } }
  iframe { position: fixed; top: var(--game-top, 180px); left: 0; width: 100%; height: calc(100dvh - var(--game-top, 180px)); border: 0; background: var(--dark-room-bg); }
  noscript { position: relative; z-index: 11; display: block; padding: 200px 24px 48px; text-align: center; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
</style>
<script is:inline>
  (() => {
    const frame = document.getElementById('dark-room-app');
    const head = document.querySelector('.masthead');
    if (!frame || !head) return;
    const page = document.querySelector('.dark-room-page');
    const setTheme = (dark) => { page.dataset.theme = dark ? 'dark' : 'light'; };
    // Match the saved theme before the iframe finishes loading, then follow
    // the game's actual computed background (including subsequent light toggles).
    try { setTheme(Boolean(JSON.parse(localStorage.getItem('amazingindex.dark-room.gameState'))?.config?.lightsOff)); } catch (_) {}
    const syncTheme = () => {
      const body = frame.contentDocument?.body;
      if (body) setTheme(frame.contentWindow.getComputedStyle(body).backgroundColor === 'rgb(39, 40, 35)');
    };
    const ready = () => {
      syncTheme();
      resize();
      const doc = frame.contentDocument;
      frame.contentWindow?.addEventListener('dark-room-started', syncTheme);
      doc?.addEventListener('load', syncTheme, true);
      doc?.addEventListener('click', () => requestAnimationFrame(syncTheme));
      frame.contentWindow?.focus();
    };
    const params = new URLSearchParams(location.search);
    const src = new URL(frame.src);
    for (const key of ['lang', 'ignorebrowser']) {
      if (params.has(key)) src.searchParams.set(key, params.get(key));
    }
    if (src.href !== frame.src) frame.src = src.href;
    const resize = () => {
      const bottom = Math.ceil(head.getBoundingClientRect().bottom);
      const account = head.querySelector('[data-community-account]');
      if (account) page.style.setProperty('--game-controls-right', `${Math.max(16, innerWidth - account.getBoundingClientRect().right)}px`);
      page.style.setProperty('--game-top', `${bottom}px`);
      frame.style.setProperty('--game-top', `${bottom + 40}px`);
      // Share the masthead's actual edges with the isolated game document.
      // Keep the original scrollable stage on narrow windows.
      const nav = head.querySelector('.nav-tab');
      const root = frame.contentDocument?.documentElement;
      if (root) {
        root.toggleAttribute('data-site-edges', innerWidth >= 992 && Boolean(nav && account));
        if (nav && account) {
          const bounds = frame.getBoundingClientRect();
          // Update both coordinate spaces together. Waiting for the iframe's
          // next animation frame briefly leaves the narrative at its old width.
          const wrapper = frame.contentDocument?.getElementById('wrapper');
          if (wrapper) root.style.setProperty('--game-wrapper-left', `${wrapper.getBoundingClientRect().left}px`);
          root.style.setProperty('--site-nav-left', `${nav.getBoundingClientRect().left - bounds.left}px`);
          root.style.setProperty('--site-inventory-right', `${bounds.right - account.getBoundingClientRect().right}px`);
        }
      }
    };
    resize();
    if (window.ResizeObserver) new ResizeObserver(resize).observe(head);
    window.addEventListener('resize', resize);
    frame.addEventListener('load', ready);
    if (frame.contentDocument?.readyState === 'complete' && frame.contentDocument.URL !== 'about:blank') ready();
  })();
</script>
<script>
  import '../scripts/dark-room';
</script>

