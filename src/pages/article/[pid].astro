---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getAllArticleRouteItems, getArticleRouteItemsFor, getBuildDates, getItemsByDate } from '../../lib/data';
import { isDailyBuild } from '../../lib/build-scope';
import { uniqueArticleItems } from '../../lib/sitemap';

// One page per article, dated by the newest edition it appears in. A daily
// build renders the articles whose newest edition is one it renders.
export async function getStaticPaths() {
  let routes;
  if (isDailyBuild()) {
    const dates = await getBuildDates();
    const pids = (await Promise.all(dates.map(getItemsByDate))).flat().map(item => item.processed_item_id);
    const inScope = new Set(dates);
    routes = uniqueArticleItems(await getArticleRouteItemsFor(pids)).filter(item => inScope.has(item.snapshot_date));
  } else {
    routes = uniqueArticleItems(await getAllArticleRouteItems());
  }
  return routes.map(item => ({
    params: { pid: item.processed_item_id },
    props: { snapshotDate: item.snapshot_date },
  }));
}

const { pid } = Astro.params;
const { snapshotDate: date } = Astro.props;
const items = await getItemsByDate(date);
const currentIndex = items.findIndex(i => i.processed_item_id === pid);
const item = items[currentIndex];
if (!item) throw new Error(`Missing article ${pid} in snapshot ${date}`);
const prevItem = currentIndex > 0 ? items[currentIndex - 1] : null;
const nextItem = currentIndex >= 0 && currentIndex < items.length - 1 ? items[currentIndex + 1] : null;
---

<ArticleLayout
  item={item}
  date={date}
  items={items}
  prevItem={prevItem}
  nextItem={nextItem}
/>
