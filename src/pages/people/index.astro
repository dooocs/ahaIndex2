---
// 人物: the people 蜗牛 chose to follow closely, at most 100 (persons.featured_rank
// in the Aliyun database, src/lib/people-home.ts), five to a row in rank
// order. Each card: initial or photo, name, what they do, and up to three
// tags (what others call them, then their fields). Everyone else — mostly
// the X accounts in 动态 — keeps a person page, reached from the feed, but
// is not listed here. Rebuilt with the hourly feed deploy.
import TabLayout from '../../layouts/TabLayout.astro';
import { getPeople } from '../../lib/people-data';
import { FEATURED_LIMIT } from '../../lib/people-home';
import { PEOPLE_PATH } from '../../lib/people';
import { SITE_URL, siteTitle } from '../../lib/site';
import '../../styles/people.css';

const { people, grids, featured } = await getPeople();
const others = people.length + grids.length - featured.length;

const intro = '一个人能认真看的人不过百位。这里只放值得细看的人，每个人的材料都精心梳理过：他们在关键时刻怎么选，后来又怎样。';
const pageTitle = siteTitle('人物 · 以人为镜');
const metaIntro = `以人为镜，可以明得失。${intro}`;
const pageDesc = featured.length > 0
  ? `${metaIntro}现在收录：${featured.slice(0, 5).map((c) => c.name).join('、')}${featured.length > 5 ? ` 等 ${featured.length} 人` : ''}。`
  : metaIntro;
const canonical = `${SITE_URL}${PEOPLE_PATH}`;
const no = (rank: number) => String(rank).padStart(2, '0');
---

<TabLayout tab="people" showScore={false} mainClass="people-page people-home" title={pageTitle} description={pageDesc} canonicalUrl={canonical} ogUrl={canonical}>
  <header class="pd-head">
    <div>
      <div class="people-k">人物 / People</div>
      <h1 class="pd-title">以人为镜，可以明得失</h1>
      <p class="pd-intro">{intro}</p>
    </div>
    <div class="pd-count"><b>{featured.length}</b><span>/ {FEATURED_LIMIT} 人</span></div>
  </header>

  {featured.length === 0 ? (
    <p class="people-empty">名单还在整理，很快上线。</p>
  ) : (
    <ol class="pd-grid">
      {featured.map((c) => (
        <li>
          <a class="pd-card" href={`${PEOPLE_PATH}/${c.slug}`}>
            <span class="pd-no">{no(c.rank)}</span>
            <span class="pd-photo" aria-hidden="true">
              {c.avatar ? <img src={c.avatar} alt="" width="64" height="64" loading="lazy" decoding="async" /> : <span>{c.initial}</span>}
            </span>
            <span class="pd-name">{c.name}</span>
            {c.alt && <span class="pd-alt">{c.alt}</span>}
            {c.role && <span class="pd-role">{c.role}</span>}
            {c.tags.length > 0 && <span class="pd-tags">{c.tags.map((t) => <span>{t}</span>)}</span>}
          </a>
        </li>
      ))}
    </ol>
  )}

  {others > 0 && (
    <p class="pd-more">
      <a href="/feed">动态</a>里的 {others} 位博主也有个人档案，点动态里的头像或名字进入。
    </p>
  )}
</TabLayout>
