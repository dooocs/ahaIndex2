---
// One person (/people/<slug>). People with a life grid (主线 / 状态 in the
// Aliyun database, src/lib/life-grid.ts) get the grid page; everyone else the
// classic page.
import PersonPage from '../../components/people/PersonPage.astro';
import LifeGridPage from '../../components/people/LifeGridPage.astro';
import { getPeople } from '../../lib/people-data';

export async function getStaticPaths() {
  const { people, grids } = await getPeople();
  return [
    ...people.map((p) => ({ params: { slug: p.slug }, props: { slug: p.slug, grid: false } })),
    ...grids.map((g) => ({ params: { slug: g.slug }, props: { slug: g.slug, grid: true } })),
  ];
}

const { slug, grid } = Astro.props as { slug: string; grid: boolean };
---

{grid ? <LifeGridPage slug={slug} /> : <PersonPage slug={slug} />}
