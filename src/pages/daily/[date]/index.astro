---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DailyPage from '../../../components/DailyPage.astro';
import { getBuildDates, getItemsByDate, getDailyArchiveByDate, getNeighborDates } from '../../../lib/data';

export async function getStaticPaths() {
  const dates = await getBuildDates();
  return dates.map(date => ({ params: { date } }));
}

const { date } = Astro.params;
const items = await getItemsByDate(date!);
const dailyArchive = await getDailyArchiveByDate(date!);
const { prev, next } = await getNeighborDates(date!);

const pageTitle = `${date} AI 行业精选简报 | AmazingIndex`;
const pageDesc = `AmazingIndex ${date} 每日 AI 行业精选简报。基于多维度量化算法，为您筛选当日最具价值的 AI 行业动态与创新洞察。`;
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  canonicalUrl={`https://www.amazingindex.com/daily/${date}`}
  ogTitle={pageTitle}
  ogDescription={pageDesc}
  ogUrl={`https://www.amazingindex.com/daily/${date}`}
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": pageTitle,
    "description": pageDesc,
    "url": `https://www.amazingindex.com/daily/${date}`
  }}
>
  <DailyPage items={items} dailyArchive={dailyArchive} date={date} prevDate={prev} nextDate={next} heading={`${date} AI 行业精选简报`} />
</BaseLayout>
