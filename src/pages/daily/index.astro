---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Masthead from '../../components/Masthead.astro';
import Footer from '../../components/Footer.astro';

// Static shell: the months and statistics are rendered in the browser from
// /data/archive/index.json, which the export script refreshes after each deploy.
const pageTitle = '历史归档 | AmazingIndex';
const pageDesc = '深入探索 AmazingIndex 过去 AI 行业动态的综合数据库，经过评分和分类，方便您发现。';
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  canonicalUrl="https://www.amazingindex.com/daily"
  ogTitle={pageTitle}
  ogDescription={pageDesc}
  ogUrl="https://www.amazingindex.com/daily"
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": pageTitle,
    "description": pageDesc,
    "url": "https://www.amazingindex.com/daily"
  }}
>
  <div class="archive-page" data-archive-year>
    <Masthead />

    <div class="layout">
      <div class="main-col">
        <div class="breadcrumb">
          <a href="/" data-astro-reload>首页</a><span class="sep">/</span>历史归档
        </div>

        <div class="page-header page-header--archive-year">
          <h1>历史归档</h1>
        </div>

        <div class="archive-year-rail" data-year-rail></div>

        <div class="month-grid" data-month-grid>
          <div class="loading-state" data-loading>正在加载归档…</div>
        </div>
      </div>

      <div class="side-col">
        <div class="side-section">
          <div class="side-title">全局统计</div>
          <div class="side-stats" data-global-stats></div>
        </div>

        <div class="side-section">
          <div class="side-title">分数分布</div>
          <div data-distribution></div>
        </div>

        <div class="side-section">
          <div class="side-title">关于归档</div>
          <div class="about-box">
            AmazingIndex 历史归档保存了 AI 行业的每日演进。
            每一期都是最具影响力新闻的快照，由我们的 <strong>Aha Index</strong> 算法进行评分，以在噪音中凸显真正的突破。
          </div>
        </div>

        <div class="side-footer">
          <span>AmazingIndex</span>
          <span>始于 2024</span>
        </div>
      </div>
    </div>
    <Footer />
  </div>
</BaseLayout>

<script src="../../scripts/archive-pages.ts"></script>
