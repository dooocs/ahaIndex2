---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Masthead from '../../components/Masthead.astro';
import { SITE_URL, siteTitle } from '../../lib/site';

const canonical = `${SITE_URL}/race/multiplayer`;
const gameUrl = new URL('https://game.amazingindex.com/race/multiplayer/?embed=site');
---

<BaseLayout title={siteTitle('西湖飞车 · 多人联机')} description="叫上朋友，联机绕西湖竞速。" canonicalUrl={canonical} ogUrl={canonical} noindex>
  <Masthead tab="race" showScore={false} overlay />
  <main class="multiplayer-page">
    <h1 class="sr-only">西湖飞车 · 多人联机</h1>
    <iframe id="race-multiplayer-app" class="multiplayer-app" src={gameUrl.href} title="西湖飞车 · 多人联机" referrerpolicy="origin" allow="fullscreen; autoplay"></iframe>
    <noscript><p>西湖飞车多人联机需要开启 JavaScript。<a href="/race">返回单人比赛</a></p></noscript>
  </main>
</BaseLayout>

<style>
  :global(html:has(.multiplayer-page)), :global(body:has(.multiplayer-page)) {
    overflow: hidden;
    scrollbar-gutter: auto;
  }
  .multiplayer-page { margin: 0; padding: 0; }
  .multiplayer-app { position: fixed; inset: 0; display: block; width: 100%; height: 100%; border: 0; background: #cfe9e4; }
  .multiplayer-page noscript p { position: relative; z-index: 11; padding: 200px 24px 48px; text-align: center; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
</style>

<script is:inline>
  (() => {
    const frame = document.getElementById('race-multiplayer-app');
    const head = document.querySelector('header.masthead--overlay');
    if (!frame || !head) return;
    const gameOrigin = new URL(frame.src).origin;
    const sendInset = () => {
      frame.contentWindow?.postMessage({ type: 'race:inset', top: Math.round(head.getBoundingClientRect().bottom) }, gameOrigin);
    };
    const resizeObserver = new ResizeObserver(sendInset);
    resizeObserver.observe(head);
    frame.addEventListener('load', sendInset);
    sendInset();
    const onMessage = (event) => {
      if (event.origin !== gameOrigin || event.source !== frame.contentWindow) return;
      if (event.data?.type === 'race:back-to-solo') location.assign('/race');
      if (event.data?.type === 'race:inset-ready') sendInset();
    };
    window.addEventListener('message', onMessage);
    document.addEventListener('astro:before-swap', () => {
      resizeObserver.disconnect();
      frame.removeEventListener('load', sendInset);
      window.removeEventListener('message', onMessage);
    }, { once: true });
  })();
</script>
