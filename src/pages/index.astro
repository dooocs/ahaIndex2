---
import DailyPage from '../components/DailyPage.astro';
import { SITE_NAME, SITE_SLOGAN } from '../lib/site';
import { getLatestDate, getItemsByDate, getLatestDailyArchive, getPreviousPublished } from '../lib/data';

const latestDate = await getLatestDate();
const items = latestDate ? await getItemsByDate(latestDate) : [];
const dailyArchive = await getLatestDailyArchive();
const prev = latestDate ? await getPreviousPublished(latestDate) : null;
---

<DailyPage items={items} dailyArchive={dailyArchive} prevDate={prev} heading={`${SITE_NAME} · ${SITE_SLOGAN}`} sidebarMode="intro" />
