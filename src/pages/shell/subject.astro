---
// Template for /subjects/<slug>. Not published itself: the export script
// copies it to each subject's URL with that subject's title, description and
// canonical URL, and the browser renders /data/subjects/<slug>.json.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Masthead from '../../components/Masthead.astro';
import Footer from '../../components/Footer.astro';
import { SITE_URL } from '../../lib/site';
import { SHELL_TOKENS } from '../../lib/site-export';
---

<BaseLayout
  title={SHELL_TOKENS.title}
  description={SHELL_TOKENS.description}
  canonicalUrl={`${SITE_URL}${SHELL_TOKENS.path}`}
>
  <Masthead />

  <main class="subject-detail-page" data-subject-detail>
    <div class="loading-state" data-loading>正在加载专题…</div>
  </main>

  <Footer />
</BaseLayout>

<script src="../../scripts/subject-pages.ts"></script>
