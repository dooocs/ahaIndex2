---
// 动态: the last 24 hours of original X posts by the bloggers Octopus follows.
// A TabLayout page: on the left one stream of posts in the order they were
// sent on X, each shown in Chinese (the original opens in a dialog); on the
// right an overview of the window built from the panel primitives (counts,
// when people posted, who posted most — click a name to see only their
// posts). In the stream, a blogger's avatar and name open their 人物 page;
// nothing on the page links to X. Rendered at build time from
// proc_feed_posts (src/lib/feed.ts);
// the hourly feed deploy (.github/workflows/feed-deploy.yml) rebuilds and
// uploads only this page.
import TabLayout from '../layouts/TabLayout.astro';
import SidePanel from '../components/panel/SidePanel.astro';
import PanelHead from '../components/panel/PanelHead.astro';
import StatRow from '../components/panel/StatRow.astro';
import PanelSection from '../components/panel/PanelSection.astro';
import { getFeed } from '../lib/data';
import FeedPost from '../components/feed/FeedPost.astro';
import { getPeople } from '../lib/people-data';
import { PEOPLE_PATH } from '../lib/people';
import { FEED_PATH, FEED_WINDOW_HOURS, beijingTime, summarize, timeline } from '../lib/feed.ts';
import { SITE_URL, siteTitle } from '../lib/site';
import '../styles/feed.css';

const posts = timeline(await getFeed());
const sum = summarize(posts);
const peak = Math.max(1, ...sum.by_hour);
// Named only when one hour stands out (at least 2 posts); otherwise it would just be the earliest hour.
const busiestHour = Math.max(...sum.by_hour) >= 2 ? sum.by_hour.indexOf(Math.max(...sum.by_hour)) : -1;

const pageTitle = siteTitle('动态 · AI 博主 24 小时');
const pageDesc = `AI 圈 ${sum.authors || ''} 位博主最近 ${FEED_WINDOW_HOURS} 小时在 X 上的原创动态，中文翻译，可查看原文，每小时更新。`;
const canonical = `${SITE_URL}${FEED_PATH}`;
// Avatar and name link to the blogger's 人物 page (every followed account has one; older posts by
// accounts no longer followed may not, and stay plain).
const { people } = await getPeople();
const personHref = new Map(people.filter((x) => x.x_handle).map((x) => [x.x_handle!.toLowerCase(), `${PEOPLE_PATH}/${x.slug}`]));
const initial = (name: string) => Array.from(name.trim())[0]?.toUpperCase() ?? '?';
const hh = (h: number) => String(h).padStart(2, '0');
---

<TabLayout tab="feed" showScore={false} mainClass="feed-page" title={pageTitle} description={pageDesc} canonicalUrl={canonical} ogUrl={canonical}>
  <h1 class="sr-only">动态 · AI 博主最近 {FEED_WINDOW_HOURS} 小时的 X 原创帖子</h1>

  <p class="feed-mobile-meta" slot="mobile-summary">
    <span>最近 {FEED_WINDOW_HOURS} 小时</span>
    <span>{sum.authors} 位博主</span>
    <span>{sum.posts} 条</span>
    {sum.latest_at && <span>最新 {beijingTime(sum.latest_at)}</span>}
  </p>

  <div class="feed-filter" data-feed-filter hidden>
    <span>只看 <b data-feed-filter-name></b> 的动态</span>
    <button type="button" data-feed-filter-clear>看全部 ×</button>
  </div>

  {posts.length === 0 ? (
    <p class="feed-empty">最近 {FEED_WINDOW_HOURS} 小时还没有新动态，晚点再来看看。</p>
  ) : (
    <ol class="feed-stream" data-feed-stream>
      {posts.map((p) => <FeedPost post={p} href={personHref.get(p.author.toLowerCase()) ?? null} filterable />)}
    </ol>
  )}

  <SidePanel slot="side">
    <PanelHead kicker="动态 / Feed" title="AI 博主" accent={`最近 ${FEED_WINDOW_HOURS} 小时`} text="AI 圈博主在 X 上的原创帖子，默认显示中文翻译，点「查看原文」看原帖，按发帖时间排列。每小时更新。" />

    <StatRow stats={[{ label: '博主', value: sum.authors }, { label: '帖子', value: sum.posts }, { label: '带图', value: sum.with_media }]} />
    {sum.latest_at && (
      <p class="feed-updated">
        最新一条 <time datetime={sum.latest_at}>{beijingTime(sum.latest_at)}</time><br />
        最早一条 <time datetime={sum.earliest_at}>{beijingTime(sum.earliest_at)}</time>
        <span>北京时间</span>
      </p>
    )}

    {sum.posts > 0 && (
      <>
        <PanelSection label="发帖时段 / By hour">
          <div class="feed-hours" role="img" aria-label="各时段（北京时间）发帖数">
            {sum.by_hour.map((n, h) => (
              <span class={n ? 'on' : ''} style={`--h:${Math.round((n / peak) * 100)}%`} title={`${hh(h)}:00 · ${n} 条`}></span>
            ))}
          </div>
          <div class="feed-hours-axis" aria-hidden="true"><span>00</span><span>06</span><span>12</span><span>18</span><span>24</span></div>
          {busiestHour >= 0 && <p class="panel-note">最热闹的时段是北京时间 {hh(busiestHour)}:00 前后。</p>}
        </PanelSection>

        <PanelSection label="谁发得最多 / Who posted">
          <ol class="feed-authors">
            {sum.top_authors.map((a) => (
              <li>
                <button type="button" class="feed-author-btn" data-feed-author={a.handle.toLowerCase()} data-feed-name={a.display_name}>
                  <span class="feed-author-avatar" aria-hidden="true">
                    {a.avatar_url ? <img src={a.avatar_url} alt="" width="22" height="22" loading="lazy" decoding="async" /> : initial(a.display_name)}
                  </span>
                  <span class="feed-author-name">{a.display_name}</span>
                  <span class="feed-author-count">{a.posts}</span>
                </button>
              </li>
            ))}
          </ol>
          <p class="panel-note">点名字只看这位博主。</p>
        </PanelSection>
      </>
    )}
  </SidePanel>
</TabLayout>

<script>
  // Click a name in the side panel to show only that blogger's posts; click it
  // again (or 看全部) to show everything. No URL state: the page is one window.
  const stream = document.querySelector<HTMLElement>('[data-feed-stream]');
  const bar = document.querySelector<HTMLElement>('[data-feed-filter]');
  const barName = document.querySelector<HTMLElement>('[data-feed-filter-name]');
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-feed-author]'));
  let active = '';

  function apply(handle: string, name = '') {
    active = handle;
    stream?.querySelectorAll<HTMLElement>('.feed-post').forEach((li) => {
      li.hidden = Boolean(handle) && li.dataset.author !== handle;
    });
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.feedAuthor === handle)));
    if (bar && barName) {
      bar.hidden = !handle;
      barName.textContent = name;
    }
    if (handle) stream?.closest('main')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  buttons.forEach((b) => b.addEventListener('click', () => {
    const handle = b.dataset.feedAuthor ?? '';
    apply(active === handle ? '' : handle, b.dataset.feedName ?? '');
  }));
  document.querySelector('[data-feed-filter-clear]')?.addEventListener('click', () => apply(''));
</script>
