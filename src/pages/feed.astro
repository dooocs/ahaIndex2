---
// 动态: the last 24 hours of original X posts by the bloggers Octopus follows.
// Same frame as the homepage: on the left one stream of posts in the order
// they were sent on X, each with its original text and the Chinese
// translation below it; on the right a sticky panel summing up the window
// (counts, when people posted, who posted most — click a name to see only
// their posts). Rendered at build time from proc_feed_posts (src/lib/feed.ts);
// the hourly feed deploy (.github/workflows/feed-deploy.yml) rebuilds and
// uploads only this page.
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';
import { getFeed } from '../lib/data';
import { FEED_PATH, FEED_WINDOW_HOURS, beijingTime, renderPostText, summarize, timeline } from '../lib/feed.ts';
import { SITE_URL, siteTitle } from '../lib/site';
import '../styles/feed.css';

const posts = timeline(await getFeed());
const sum = summarize(posts);
const peak = Math.max(1, ...sum.by_hour);
// Named only when one hour stands out (at least 2 posts); otherwise it would just be the earliest hour.
const busiestHour = Math.max(...sum.by_hour) >= 2 ? sum.by_hour.indexOf(Math.max(...sum.by_hour)) : -1;

const pageTitle = siteTitle('动态 · AI 博主 24 小时');
const pageDesc = `AI 圈 ${sum.authors || ''} 位博主最近 ${FEED_WINDOW_HOURS} 小时在 X 上的原创动态，原文与中文翻译对照，每小时更新。`;
const canonical = `${SITE_URL}${FEED_PATH}`;
const xProfile = (handle: string) => `https://x.com/${encodeURIComponent(handle)}`;
const initial = (name: string) => Array.from(name.trim())[0]?.toUpperCase() ?? '?';
const hh = (h: number) => String(h).padStart(2, '0');
---

<BaseLayout title={pageTitle} description={pageDesc} canonicalUrl={canonical} ogUrl={canonical}>
  <Masthead showScore={false} />

  <div class="layout feed-layout">
    <main class="main-col feed-page">
      <h1 class="sr-only">动态 · AI 博主最近 {FEED_WINDOW_HOURS} 小时的 X 原创帖子</h1>

      <p class="feed-mobile-meta">
        <span>最近 {FEED_WINDOW_HOURS} 小时</span>
        <span>{sum.authors} 位博主</span>
        <span>{sum.posts} 条</span>
        {sum.latest_at && <span>最新 {beijingTime(sum.latest_at)}</span>}
      </p>

      <div class="feed-filter" data-feed-filter hidden>
        <span>只看 <b data-feed-filter-name></b> 的动态</span>
        <button type="button" data-feed-filter-clear>看全部 ×</button>
      </div>

      {posts.length === 0 ? (
        <p class="feed-empty">最近 {FEED_WINDOW_HOURS} 小时还没有新动态，晚点再来看看。</p>
      ) : (
        <ol class="feed-stream" data-feed-stream>
          {posts.map((p) => (
            <li class="feed-post" data-author={p.author.toLowerCase()}>
              <a class="feed-avatar" href={xProfile(p.author)} target="_blank" rel="noopener nofollow" aria-hidden="true" tabindex="-1">
                {p.avatar_url
                  ? <img src={p.avatar_url} alt="" width="40" height="40" loading="lazy" decoding="async" />
                  : <span>{initial(p.display_name)}</span>}
              </a>
              <div class="feed-post-body">
                <header class="feed-post-head">
                  <a class="feed-name" href={xProfile(p.author)} target="_blank" rel="noopener nofollow">{p.display_name}</a>
                  <span class="feed-handle">@{p.author}</span>
                  <span class="feed-dot" aria-hidden="true">·</span>
                  <a class="feed-time" href={p.url} target="_blank" rel="noopener nofollow" title="在 X 查看原帖">
                    <time datetime={p.published_at}>{beijingTime(p.published_at)}</time>
                  </a>
                </header>
                {p.text_original && <div class="feed-text feed-original" set:html={renderPostText(p.text_original)} />}
                {p.text_zh && (
                  <div class="feed-text feed-zh" lang="zh-CN">
                    <span class="feed-zh-label" aria-label="中文翻译">译</span>
                    <Fragment set:html={renderPostText(p.text_zh)} />
                  </div>
                )}
                {p.media.length > 0 && (
                  <div class={`feed-media feed-media-${Math.min(p.media.length, 4)}`}>
                    {p.media.map((m) => m.type === 'photo' ? (
                      <a href={m.url} target="_blank" rel="noopener">
                        <img src={m.url} alt="" loading="lazy" decoding="async" width={m.width ?? undefined} height={m.height ?? undefined} />
                      </a>
                    ) : (
                      <a href={p.url} target="_blank" rel="noopener nofollow" class="feed-video" aria-label="在 X 播放视频">
                        <img src={m.url} alt="" loading="lazy" decoding="async" width={m.width ?? undefined} height={m.height ?? undefined} />
                        <span class="feed-play" aria-hidden="true">▶</span>
                      </a>
                    ))}
                  </div>
                )}
                <a class="feed-source" href={p.url} target="_blank" rel="noopener nofollow">在 X 查看 ↗</a>
              </div>
            </li>
          ))}
        </ol>
      )}
    </main>

    <aside class="side-col feed-side">
      <div class="feed-panel">
        <div class="feed-panel-kicker">动态 / Feed</div>
        <h2 class="feed-panel-title">AI 博主<br /><em>最近 {FEED_WINDOW_HOURS} 小时</em></h2>
        <p class="feed-panel-text">AI 圈博主在 X 上的原创帖子，原文在上、中文翻译在下，按发帖时间排列。每小时更新。</p>

        <dl class="feed-stats">
          <div><dt>博主</dt><dd>{sum.authors}</dd></div>
          <div><dt>帖子</dt><dd>{sum.posts}</dd></div>
          <div><dt>带图</dt><dd>{sum.with_media}</dd></div>
        </dl>
        {sum.latest_at && (
          <p class="feed-updated">
            最新一条 <time datetime={sum.latest_at}>{beijingTime(sum.latest_at)}</time><br />
            最早一条 <time datetime={sum.earliest_at}>{beijingTime(sum.earliest_at)}</time>
            <span>北京时间</span>
          </p>
        )}

        {sum.posts > 0 && (
          <>
            <div class="divider"></div>
            <div class="feed-panel-section">
              <div class="feed-panel-label">发帖时段 / By hour</div>
              <div class="feed-hours" role="img" aria-label="各时段（北京时间）发帖数">
                {sum.by_hour.map((n, h) => (
                  <span class={n ? 'on' : ''} style={`--h:${Math.round((n / peak) * 100)}%`} title={`${hh(h)}:00 · ${n} 条`}></span>
                ))}
              </div>
              <div class="feed-hours-axis" aria-hidden="true"><span>00</span><span>06</span><span>12</span><span>18</span><span>24</span></div>
              {busiestHour >= 0 && <p class="feed-hours-note">最热闹的时段是北京时间 {hh(busiestHour)}:00 前后。</p>}
            </div>

            <div class="divider"></div>
            <div class="feed-panel-section">
              <div class="feed-panel-label">谁发得最多 / Who posted</div>
              <ol class="feed-authors">
                {sum.top_authors.map((a) => (
                  <li>
                    <button type="button" class="feed-author-btn" data-feed-author={a.handle.toLowerCase()} data-feed-name={a.display_name}>
                      <span class="feed-author-avatar" aria-hidden="true">
                        {a.avatar_url ? <img src={a.avatar_url} alt="" width="22" height="22" loading="lazy" decoding="async" /> : initial(a.display_name)}
                      </span>
                      <span class="feed-author-name">{a.display_name}</span>
                      <span class="feed-author-count">{a.posts}</span>
                    </button>
                  </li>
                ))}
              </ol>
              <p class="feed-authors-note">点名字只看这位博主。</p>
            </div>
          </>
        )}
      </div>
    </aside>
  </div>

  <Footer />
</BaseLayout>

<script>
  // Click a name in the side panel to show only that blogger's posts; click it
  // again (or 看全部) to show everything. No URL state: the page is one window.
  const stream = document.querySelector<HTMLElement>('[data-feed-stream]');
  const bar = document.querySelector<HTMLElement>('[data-feed-filter]');
  const barName = document.querySelector<HTMLElement>('[data-feed-filter-name]');
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-feed-author]'));
  let active = '';

  function apply(handle: string, name = '') {
    active = handle;
    stream?.querySelectorAll<HTMLElement>('.feed-post').forEach((li) => {
      li.hidden = Boolean(handle) && li.dataset.author !== handle;
    });
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.feedAuthor === handle)));
    if (bar && barName) {
      bar.hidden = !handle;
      barName.textContent = name;
    }
    if (handle) stream?.closest('main')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  buttons.forEach((b) => b.addEventListener('click', () => {
    const handle = b.dataset.feedAuthor ?? '';
    apply(active === handle ? '' : handle, b.dataset.feedName ?? '');
  }));
  document.querySelector('[data-feed-filter-clear]')?.addEventListener('click', () => apply(''));
</script>
