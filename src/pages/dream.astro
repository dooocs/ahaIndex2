---
// 梦想人生: the site's masthead and tab bar on top, the 3D app below it.
// The app is a self-contained page (public/dream/app.html: a small planet with
// home, mall, sports centre, Xixi wetland and West Lake, three.js r170 and a
// subset font under public/dream/) shown in an iframe, so its full-screen styles
// and render loop stay out of the site's layout and it needs no build-time data.
// It holds several planets (杭州, 滑雪), switched inside the page; ?planet=ski opens the ski planet.
// The previous price-configurator scene is kept as public/dream/app-v1.html.
// Add ?debug to app.html to see the technique switches and the fps counter.
// Walking (collide-and-slide) lives in public/dream/js/walk; structure and roadmap: docs/dream.md.
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import { SITE_URL, siteTitle } from '../lib/site';
import { community } from '../lib/community-config';

const title = siteTitle('梦想人生');
const description = '在小星球上过你想要的生活：杭州星球有家、天街、文体中心、西溪湿地和西湖；滑雪星球有北海道的粉雪、羊蹄山和温泉，还有崇礼和雪如意。';
const canonical = `${SITE_URL}/dream`;
// who else is online (Realtime presence) runs on the community project; only its public URL and publishable key
const realtime = community ? { url: community.url, key: community.key } : null;
---

<BaseLayout title={title} description={description} canonicalUrl={canonical} ogUrl={canonical}>
  <Masthead tab="dream" showScore={false} overlay />
  <main class="dream-page">
    <h1 class="sr-only">梦想人生</h1>
    <iframe id="dream-app" class="dream-app" src="/dream/app.html" title="梦想人生 · 3D 场景" allow="fullscreen"></iframe>
    <noscript><p class="dream-noscript">梦想人生是一个 3D 场景，需要开启 JavaScript。</p></noscript>
  </main>
</BaseLayout>

<style>
  /* Immersive: the scene fills the whole window and the masthead floats over it. */
  :global(html:has(.dream-page)), :global(body:has(.dream-page)) { overflow: hidden; scrollbar-gutter: auto; }
  .dream-page { margin: 0; padding: 0; }
  .dream-app {
    position: fixed;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    background: #8fd3d4;
  }
  .dream-noscript { position: relative; z-index: 11; padding: 200px 24px 48px; text-align: center; color: var(--muted); }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
</style>

<script is:inline define:vars={{ realtime }}>
  // Tell the scene how tall the masthead over it is, so it keeps its controls and framing
  // clear of it, hand it the Realtime config for the online count, and the keyboard so WASD works straight away.
  (() => {
    const frame = document.getElementById('dream-app');
    const head = document.querySelector('.masthead');
    if (!frame || !head) return;
    const send = () => frame.contentWindow && frame.contentWindow.postMessage({ type: 'dream:inset', top: Math.round(head.getBoundingClientRect().bottom) }, location.origin);
    const ready = () => {
      send();
      if (realtime) frame.contentWindow.postMessage({ type: 'dream:config', realtime }, location.origin);
      frame.contentWindow.focus();
    };
    frame.addEventListener('load', ready);
    if (frame.contentDocument && frame.contentDocument.readyState === 'complete' && frame.contentDocument.URL !== 'about:blank') ready();
    if (window.ResizeObserver) new ResizeObserver(send).observe(head);
    window.addEventListener('resize', send);
  })();
</script>
