---
// Static shell: sections and signal statistics are rendered in the browser
// from /data/subjects/index.json, which the export script refreshes daily.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Masthead from '../../components/Masthead.astro';
import Footer from '../../components/Footer.astro';

const pageTitle = 'AI 专题索引 | 蜗牛杂货站';
const pageDesc = '蜗牛杂货站 AI 专题索引：跟踪 AI 相关人物、公司、产品、技术方向和近期信号。';
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  canonicalUrl="https://www.amazingindex.com/subjects"
  ogTitle={pageTitle}
  ogDescription={pageDesc}
  ogUrl="https://www.amazingindex.com/subjects"
>
  <Masthead />

  <main class="subjects-page" data-subject-index>
    <header class="subject-dir-head">
      <div class="subject-kicker">Subject Index</div>
      <h1>AI 专题索引</h1>
      <div class="subject-dir-meta" data-subject-meta></div>
    </header>

    <div data-subject-directory>
      <div class="loading-state" data-loading>正在加载专题…</div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<script src="../../scripts/subject-pages.ts"></script>
