---
import type { ProcessedItem } from '../lib/types';
import SiteNav from './SiteNav.astro';
import { SITE_SLOGAN, type SectionId } from '../lib/site';

interface Props {
  items?: ProcessedItem[];
  showScore?: boolean;
  /** The section whose tab is lit; defaults to the one the URL belongs to. */
  tab?: SectionId | null;
}

const { items = [], showScore = true, tab } = Astro.props;

const displayDate = items.length > 0 && items[0].snapshot_date
  ? new Date(items[0].snapshot_date + 'T00:00:00')
  : new Date();

const year = displayDate.getFullYear();
const month = String(displayDate.getMonth() + 1).padStart(2, '0');
const day = String(displayDate.getDate()).padStart(2, '0');

const ahaScore = items.length > 0
  ? (items.reduce((sum, item) => sum + (item.aha_index || 0), 0) / items.length * 100).toFixed(1)
  : '0.0';
---

<header class="masthead">
  <div class="masthead-inner">
    <div class="masthead-logo">
      <a href="/" class="logo" style="text-decoration: none;" data-astro-reload>
        <svg class="logo-icon" viewBox="0 0 26 20" fill="none" stroke="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M24.5 17.6 H9 C6 17.6 4.3 16.2 4.3 13.4" stroke-width="1.9" stroke-linecap="round"/>
          <path d="M4.3 13.4 L2.6 9.4 M5 13 L6.4 9.2" stroke-width="1.4" stroke-linecap="round"/>
          <circle cx="2.6" cy="9.4" r="0.9" fill="currentColor" stroke="none"/>
          <circle cx="6.4" cy="9.2" r="0.9" fill="currentColor" stroke="none"/>
          <circle cx="15.6" cy="10.6" r="6.4" stroke-width="1.9"/>
          <path d="M15.6 10.6 A1 1 0 0 1 17.6 10.6 A2 2 0 0 1 13.6 10.6 A3 3 0 0 1 19.6 10.6" stroke-width="1.4" stroke-linecap="round"/>
        </svg>
        <span class="logo-text">向上<span>研究所</span></span>
      </a>
    </div>

    <div class="masthead-title">
      <span class="masthead-tagline">AMAZINGINDEX.COM</span>
      <span class="masthead-subtitle">{SITE_SLOGAN}</span>
    </div>

    <div class="masthead-meta">
      {showScore && <div class="aha-score-mobile">
        <span class="score-trigger">{ahaScore}</span>
      </div>}
      <div class="masthead-vol">
        VOL. {year}.{month}<br/>
        {year}.{month}.{day}
      </div>
    </div>
  </div>
  <SiteNav tab={tab} />
</header>
