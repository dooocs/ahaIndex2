---
import type { ProcessedItem, DailyArchive } from '../lib/types';
import { SITE_INTRO, visibleShelves } from '../lib/site';
import { community } from '../lib/community-config';
import SidePanel from './panel/SidePanel.astro';
import PanelHead from './panel/PanelHead.astro';

interface Props {
  items?: ProcessedItem[];
  dailyArchive?: DailyArchive | null;
  mode?: 'score' | 'intro';
  /** The edition this page shows; the calendar and chart end there. Empty = the newest edition. */
  date?: string;
}

const {
  items = [],
  dailyArchive = null,
  mode = 'score',
  date = '',
} = Astro.props;

const ahaScore = items.length > 0
  ? (items.reduce((sum, item) => sum + (item.aha_index || 0), 0) / items.length * 100).toFixed(1)
  : '0.0';

// Shelves listed in the homepage intro; the personals board only appears once community is enabled.
const shelves = visibleShelves(Boolean(community));

// The intro (homepage) is a SidePanel; the score card keeps its own sticky offset.
const Panel = mode === 'intro' ? SidePanel : 'div';
const panelClass = mode === 'intro' ? 'sidebar-panel-intro' : 'aha-score-card';
---

<Panel class={panelClass} data-sidebar data-date={date}>
    {mode === 'intro' ? (
      <PanelHead kicker="关于本站 / About" title="让生活多一点" accent="Amazing" text={SITE_INTRO}>
        <div class="sidebar-shelves">
          <div class="sidebar-shelves-title">店里有什么 / On the shelves</div>
          <ol class="shelf-list">
            {shelves.map((shelf, i) => (
              <li>
                <a href={shelf.href} class="shelf" data-astro-reload>
                  <span class="shelf-no">{String(i + 1).padStart(2, '0')}</span>
                  <span class="shelf-body">
                    <span class="shelf-name">{shelf.name}</span>
                    <span class="shelf-desc">{shelf.desc}</span>
                  </span>
                  <span class="shelf-arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ol>
          <p class="shelf-more">更多新东西，正在慢慢上架。<a href="/about" data-astro-reload>关于本站 →</a></p>
        </div>
      </PanelHead>
    ) : (
      <>
      <div class="score-header">推荐指数 / WORTH READING</div>
      <div class="score-display">
        <span class="score-number" data-score-number>{ahaScore}</span>
        <div class="score-unit">综合评分 · 满分 100</div>
        {dailyArchive?.percentile_tier === 'p90_plus' && (
          <div class="percentile-line percentile-p90">今日罕见高分 · 近 90 天前 10%</div>
        )}
        {dailyArchive?.percentile_tier === 'p70_p90' && (
          <div class="percentile-line percentile-p70">高于近期均值</div>
        )}
      </div>
      <div class="score-chart" data-score-chart></div>
      </>
    )}

    <div class="divider"></div>
    <div class="sidebar-archive">
      <div class="sidebar-archive-section">
        <div class="sidebar-archive-title">Archive</div>
        <table class="mini-cal" style="width: 100%; border-collapse: collapse; font-size: 11px; text-align: center;">
          <thead>
            <tr><th>S</th><th>M</th><th>T</th><th>W</th><th>T</th><th>F</th><th>S</th></tr>
          </thead>
          <tbody data-mini-cal></tbody>
        </table>
        <a href="/daily" style="display: block; text-align: center; font-size: 10px; letter-spacing: 1px; color: var(--accent); margin-top: 16px; text-decoration: none;">
          全部 <span data-total-editions>—</span> 期日报 →
        </a>
      </div>
    </div>

    {mode !== 'intro' && (
      <>
      <div class="divider"></div>
      <p class="about-text">
        AmazingIndex 是<a href="/about" class="about-text-link">蜗牛杂货站</a>的每日 AI 精选栏目，用一套多维度量化算法，从全网筛出当下最值得关注的创新成果。
      </p>
      </>
    )}
</Panel>

<script src="../scripts/sidebar.ts"></script>

<style>
  .sidebar-panel-intro .sidebar-archive-section {
    margin-bottom: 0;
  }

  .sidebar-panel-intro .sidebar-archive-title {
    border-bottom: none;
    margin-bottom: 10px;
    padding-bottom: 0;
    color: rgba(26, 22, 18, 0.34);
  }

  .sidebar-shelves {
    margin-top: 22px;
  }

  .sidebar-shelves-title {
    font-size: 9px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 6px;
  }

  .shelf-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .shelf {
    display: grid;
    grid-template-columns: 24px 1fr auto;
    align-items: baseline;
    gap: 8px;
    padding: 11px 0;
    border-bottom: 1px solid var(--border);
    color: var(--ink);
    text-decoration: none;
  }

  .shelf-no {
    font-family: var(--fm);
    font-size: 10px;
    color: var(--muted);
  }

  .shelf-body {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .shelf-name {
    font-family: var(--fs);
    font-size: 14px;
    font-weight: 700;
    line-height: 1.3;
  }

  .shelf-desc {
    font-family: var(--fs);
    font-size: 11.5px;
    line-height: 1.6;
    color: rgba(26, 22, 18, 0.58);
  }

  .shelf-arrow {
    font-family: var(--fm);
    font-size: 11px;
    color: var(--muted);
    transition: transform 0.2s, color 0.2s;
  }

  .shelf:hover .shelf-name,
  .shelf:hover .shelf-arrow {
    color: var(--accent);
  }

  .shelf:hover .shelf-arrow {
    transform: translateX(3px);
  }

  .shelf-more {
    margin: 12px 0 0;
    font-family: var(--fs);
    font-size: 11.5px;
    color: rgba(26, 22, 18, 0.5);
  }

  .shelf-more a {
    color: var(--accent);
    text-decoration: none;
    margin-left: 4px;
  }

  .about-text-link {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

</style>
