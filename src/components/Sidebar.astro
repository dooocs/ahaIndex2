---
import type { ProcessedItem, DailyArchive, GlobalStats } from '../lib/types';
import { SHELVES } from '../lib/site';
import { community } from '../lib/community-config';

interface Props {
  items?: ProcessedItem[];
  stats?: GlobalStats | null;
  days?: DailyArchive[];
  dailyArchive?: DailyArchive | null;
  mode?: 'score' | 'intro';
}

const {
  items = [],
  stats = null,
  days = [],
  dailyArchive = null,
  mode = 'score',
} = Astro.props;

const ahaScore = items.length > 0
  ? (items.reduce((sum, item) => sum + (item.aha_index || 0), 0) / items.length * 100).toFixed(1)
  : '0.0';

// Shelves listed in the homepage intro; the personals board only appears once community is enabled.
const shelves = SHELVES.filter((shelf) => shelf.href !== '/meet' || community);

// Build 7-day bar chart from real days data (sorted desc, take first 7, reverse to chronological)
const recentDays = days.slice(0, 7).reverse();
const maxScore = Math.max(...recentDays.map(d => d.aha_score), 1);

const now = new Date();
const year = now.getFullYear();
const month = now.getMonth();
const firstDay = new Date(year, month, 1).getDay();
const daysInMonth = new Date(year, month + 1, 0).getDate();
const today = now.getDate();

const weeks: (number | null)[][] = [];
let currentWeek: (number | null)[] = Array(7).fill(null);
for (let i = 0; i < firstDay; i++) {
  currentWeek[i] = null;
}
let currentDay = 1;
for (let i = firstDay; i < 7; i++) {
  currentWeek[i] = currentDay++;
}
weeks.push([...currentWeek]);
while (currentDay <= daysInMonth) {
  currentWeek = Array(7).fill(null);
  for (let i = 0; i < 7 && currentDay <= daysInMonth; i++) {
    currentWeek[i] = currentDay++;
  }
  weeks.push([...currentWeek]);
}

function hasEdition(d: number) {
  const dateStr = `${year}-${String(month + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
  return days.some(day => day.snapshot_date === dateStr && day.item_count > 0);
}

function dateStr(d: number) {
  return `${year}-${String(month + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
}
---

<aside class="side-col">
  <div class={mode === 'intro' ? 'sidebar-panel sidebar-panel-intro' : 'aha-score-card'}>
    {mode === 'intro' ? (
      <div class="sidebar-intro-card">
        <div class="sidebar-intro-kicker">关于本站 / About</div>
        <h2 class="sidebar-intro-title">
          让生活多一点<br />
          <em>Amazing</em>
        </h2>
        <p class="sidebar-intro-text">
          蜗牛杂货站是一个独立开发者开的小站。我们用大规模计算替你看遍全网，把值得知道的技术、值得用的工具、值得认识的人带到你面前。好东西，不该只有少数人知道。
        </p>
        <div class="sidebar-shelves">
          <div class="sidebar-shelves-title">店里有什么 / On the shelves</div>
          <ol class="shelf-list">
            {shelves.map((shelf, i) => (
              <li>
                <a href={shelf.href} class="shelf" data-astro-reload>
                  <span class="shelf-no">{String(i + 1).padStart(2, '0')}</span>
                  <span class="shelf-body">
                    <span class="shelf-name">{shelf.name}</span>
                    <span class="shelf-desc">{shelf.desc}</span>
                  </span>
                  <span class="shelf-arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ol>
          <p class="shelf-more">更多新东西，正在慢慢上架。<a href="/about" data-astro-reload>关于本站 →</a></p>
        </div>
      </div>
    ) : (
      <>
      <div class="score-header">推荐指数 / WORTH READING</div>
      <div class="score-display">
        <span class="score-number">{ahaScore}</span>
        <div class="score-unit">综合评分 · 满分 100</div>
        {dailyArchive?.percentile_tier === 'p90_plus' && (
          <div class="percentile-line percentile-p90">今日罕见高分 · 近 90 天前 10%</div>
        )}
        {dailyArchive?.percentile_tier === 'p70_p90' && (
          <div class="percentile-line percentile-p70">高于近期均值</div>
        )}
      </div>
      <div class="score-chart">
        {recentDays.map((d, i) => {
          const pct = Math.round((d.aha_score / maxScore) * 100);
          const isLast = i === recentDays.length - 1;
          const weekday = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'][new Date(d.snapshot_date + 'T00:00:00').getDay()];
          return <div class={`bar${isLast ? ' today' : ''}`} style={`height: ${pct}%`} title={`${weekday} ${d.aha_score.toFixed(0)}`}></div>;
        })}
      </div>
      </>
    )}

    <div class="divider"></div>
    <div class="sidebar-archive">
      <div class="sidebar-archive-section">
        <div class="sidebar-archive-title">Archive</div>
        <table class="mini-cal" style="width: 100%; border-collapse: collapse; font-size: 11px; text-align: center;">
          <thead>
            <tr><th>S</th><th>M</th><th>T</th><th>W</th><th>T</th><th>F</th><th>S</th></tr>
          </thead>
          <tbody>
            {weeks.map((week) => (
              <tr>
                {week.map((d) => {
                  if (!d) return <td></td>;
                  const has = hasEdition(d);
                  const isToday = d === today;
                  let className = '';
                  if (has) className += ' has-ed';
                  if (isToday) className += ' today-cell';
                  if (!has && d < today) className += ' empty';
                  return has
                    ? <td class={className.trim()}><a href={`/daily/${dateStr(d)}`} style="color: inherit; text-decoration: none;">{d}</a></td>
                    : <td class={className.trim()}>{d}</td>;
                })}
              </tr>
            ))}
          </tbody>
        </table>
        <a href="/daily" style="display: block; text-align: center; font-size: 10px; letter-spacing: 1px; color: var(--accent); margin-top: 16px; text-decoration: none;">
          全部 {stats?.total_editions || 0} 期日报 →
        </a>
      </div>
    </div>

    {mode !== 'intro' && (
      <>
      <div class="divider"></div>
      <p class="about-text">
        AmazingIndex 是<a href="/about" class="about-text-link">蜗牛杂货站</a>的每日 AI 精选栏目，用一套多维度量化算法，从全网筛出当下最值得关注的创新成果。
      </p>
      </>
    )}
  </div>
</aside>

<style>
  .sidebar-panel {
    position: sticky;
    top: 24px;
    max-height: calc(100vh - 48px);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;
  }

  .sidebar-panel::-webkit-scrollbar {
    display: none;
  }

  .sidebar-panel-intro {
    position: sticky;
  }

  .sidebar-panel-intro .divider {
    margin: 22px 0 18px;
  }

  .sidebar-panel-intro .sidebar-archive-section {
    margin-bottom: 0;
  }

  .sidebar-panel-intro .sidebar-archive-title {
    border-bottom: none;
    margin-bottom: 10px;
    padding-bottom: 0;
    color: rgba(26, 22, 18, 0.34);
  }

  .sidebar-intro-card {
    padding-right: 4px;
  }

  .sidebar-intro-kicker {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 9px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 14px;
  }

  .sidebar-intro-kicker::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  .sidebar-intro-title {
    font-family: var(--fd);
    font-size: 23px;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--ink);
    margin: 0 0 16px;
  }

  .sidebar-intro-title em {
    font-family: var(--fd);
    font-style: italic;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: -0.01em;
  }

  .sidebar-intro-text {
    font-family: var(--fs);
    font-size: 13px;
    line-height: 1.9;
    color: rgba(26, 22, 18, 0.72);
  }

  .sidebar-shelves {
    margin-top: 22px;
  }

  .sidebar-shelves-title {
    font-size: 9px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 6px;
  }

  .shelf-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .shelf {
    display: grid;
    grid-template-columns: 24px 1fr auto;
    align-items: baseline;
    gap: 8px;
    padding: 11px 0;
    border-bottom: 1px solid var(--border);
    color: var(--ink);
    text-decoration: none;
  }

  .shelf-no {
    font-family: var(--fm);
    font-size: 10px;
    color: var(--muted);
  }

  .shelf-body {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .shelf-name {
    font-family: var(--fs);
    font-size: 14px;
    font-weight: 700;
    line-height: 1.3;
  }

  .shelf-desc {
    font-family: var(--fs);
    font-size: 11.5px;
    line-height: 1.6;
    color: rgba(26, 22, 18, 0.58);
  }

  .shelf-arrow {
    font-family: var(--fm);
    font-size: 11px;
    color: var(--muted);
    transition: transform 0.2s, color 0.2s;
  }

  .shelf:hover .shelf-name,
  .shelf:hover .shelf-arrow {
    color: var(--accent);
  }

  .shelf:hover .shelf-arrow {
    transform: translateX(3px);
  }

  .shelf-more {
    margin: 12px 0 0;
    font-family: var(--fs);
    font-size: 11.5px;
    color: rgba(26, 22, 18, 0.5);
  }

  .shelf-more a {
    color: var(--accent);
    text-decoration: none;
    margin-left: 4px;
  }

  .about-text-link {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

</style>
