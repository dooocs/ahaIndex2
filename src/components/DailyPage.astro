---
import Masthead from './Masthead.astro';
import BriefingCard from './BriefingCard.astro';
import Sidebar from './Sidebar.astro';
import Footer from './Footer.astro';
import type { ProcessedItem, DailyArchive } from '../lib/types';
import { SITE_NAME, SITE_SLOGAN } from '../lib/site';

interface Props {
  items: ProcessedItem[];
  dailyArchive?: DailyArchive | null;
  date?: string;
  /** Neighbouring edition dates, linked as 上一期 / 下一期. */
  prevDate?: string | null;
  nextDate?: string | null;
  showArchiveBanner?: boolean;
  heading?: string;
  sidebarMode?: 'score' | 'intro';
}

const {
  items,
  dailyArchive = null,
  date,
  prevDate = null,
  nextDate = null,
  showArchiveBanner = true,
  heading,
  sidebarMode = 'score',
} = Astro.props;

const snapshotDate = date || (items.length > 0 ? items[0].snapshot_date : undefined);
const isHome = sidebarMode === 'intro';
---

<Masthead items={items} />

<div class="layout">
  <main class="main-col">
    {heading && <h1 class="sr-only">{heading}</h1>}
    {isHome && (
      <a href="/about" class="home-intro-mobile" data-astro-reload>
        <span class="home-intro-name">{SITE_NAME}</span>
        <span class="home-intro-slogan">{SITE_SLOGAN}</span>
        <span class="home-intro-more" aria-hidden="true">关于本站 →</span>
      </a>
    )}
    <div class="article-list" id="article-list">
      {items.length > 0 ? (
        items.map((item, index) => (
          <BriefingCard item={item} index={index} date={snapshotDate} />
        ))
      ) : (
        <div class="loading-state">今日暂无更新</div>
      )}
    </div>
    {(prevDate || nextDate) && (
      <nav class="edition-nav" aria-label="往期导航">
        {prevDate ? <a href={`/daily/${prevDate}`} rel="prev">← 上一期 · {prevDate}</a> : <span></span>}
        {nextDate ? <a href={`/daily/${nextDate}`} rel="next">下一期 · {nextDate} →</a> : <span></span>}
      </nav>
    )}
  </main>
  <Sidebar items={items} dailyArchive={dailyArchive} mode={sidebarMode} date={snapshotDate} />
</div>

<Footer showArchiveBanner={showArchiveBanner} date={snapshotDate} />

<style>
  .edition-nav {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin: 32px 0 8px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
    font-family: var(--fm);
    font-size: 11px;
    letter-spacing: 0.05em;
  }

  .edition-nav a {
    color: var(--accent);
    text-decoration: none;
  }

  .edition-nav a:hover {
    color: var(--ink);
  }

  .home-intro-mobile {
    display: none;
  }

  @media (max-width: 768px) {
    .home-intro-mobile {
      display: flex;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 4px 10px;
      margin: 0 0 22px;
      padding: 12px 14px;
      background: var(--paper-dark);
      color: var(--ink);
      text-decoration: none;
    }

    .home-intro-name {
      font-family: var(--fs);
      font-size: 14px;
      font-weight: 700;
    }

    .home-intro-slogan {
      font-family: var(--fs);
      font-size: 12px;
      color: rgba(26, 22, 18, 0.62);
    }

    .home-intro-more {
      margin-left: auto;
      font-family: var(--fm);
      font-size: 10px;
      color: var(--accent);
    }
  }
</style>
