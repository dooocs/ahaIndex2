---
import Masthead from './Masthead.astro';
import BriefingCard from './BriefingCard.astro';
import Sidebar from './Sidebar.astro';
import Footer from './Footer.astro';
import type { ProcessedItem, DailyArchive, GlobalStats } from '../lib/types';
import { SITE_NAME, SITE_SLOGAN, DAILY_TAGLINE } from '../lib/site';

interface Props {
  items: ProcessedItem[];
  stats: GlobalStats;
  days: DailyArchive[];
  dailyArchive?: DailyArchive | null;
  date?: string;
  showArchiveBanner?: boolean;
  heading?: string;
  subtitle?: string;
  sidebarMode?: 'score' | 'intro';
}

const {
  items,
  stats,
  days,
  dailyArchive = null,
  date,
  showArchiveBanner = true,
  heading,
  subtitle = 'AmazingIndex · 每日 AI 精选',
  sidebarMode = 'score',
} = Astro.props;

const snapshotDate = date || (items.length > 0 ? items[0].snapshot_date : undefined);
const isHome = sidebarMode === 'intro';
const editionLabel = snapshotDate ? snapshotDate.replaceAll('-', '.') : '';
---

<Masthead items={items} subtitle={subtitle} />

<div class="layout">
  <main class="main-col">
    {heading && <h1 class="sr-only">{heading}</h1>}
    {isHome && (
      <a href="/about" class="home-intro-mobile" data-astro-reload>
        <span class="home-intro-name">{SITE_NAME}</span>
        <span class="home-intro-slogan">{SITE_SLOGAN}</span>
        <span class="home-intro-more" aria-hidden="true">关于本站 →</span>
      </a>
    )}
    <div class="column-head">
      <span class="column-name">{DAILY_TAGLINE}</span>
      {editionLabel && <span class="column-meta">{isHome ? `今日 · ${editionLabel}` : editionLabel} · {items.length} 条</span>}
    </div>
    <div class="article-list" id="article-list">
      {items.length > 0 ? (
        items.map((item, index) => (
          <BriefingCard item={item} index={index} date={snapshotDate} />
        ))
      ) : (
        <div class="loading-state">今日暂无更新</div>
      )}
    </div>
  </main>
  <Sidebar items={items} stats={stats} days={days} dailyArchive={dailyArchive} mode={sidebarMode} />
</div>

<Footer showArchiveBanner={showArchiveBanner} date={snapshotDate} />

<style>
  .column-head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px 12px;
    padding-bottom: 12px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
  }

  .column-name {
    font-family: var(--fs);
    font-size: 15px;
    font-weight: 700;
    color: var(--ink);
  }

  .column-meta {
    margin-left: auto;
    font-family: var(--fm);
    font-size: 10px;
    letter-spacing: 0.12em;
    color: var(--muted);
  }

  .home-intro-mobile {
    display: none;
  }

  @media (max-width: 768px) {
    .home-intro-mobile {
      display: flex;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 4px 10px;
      margin: 0 0 22px;
      padding: 12px 14px;
      background: var(--paper-dark);
      color: var(--ink);
      text-decoration: none;
    }

    .home-intro-name {
      font-family: var(--fs);
      font-size: 14px;
      font-weight: 700;
    }

    .home-intro-slogan {
      font-family: var(--fs);
      font-size: 12px;
      color: rgba(26, 22, 18, 0.62);
    }

    .home-intro-more {
      margin-left: auto;
      font-family: var(--fm);
      font-size: 10px;
      color: var(--accent);
    }

    .column-meta {
      margin-left: 0;
      flex-basis: 100%;
    }
  }
</style>
