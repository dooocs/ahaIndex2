---
// 人生网格页（/people/<slug>，有主线或状态的人）。数据：src/lib/life-grid.ts。
//
// 按年份排的网格：年份、年龄、主线泳道（越长越坚持）、身份 / 财富 / 家庭等
// 状态、事件。点一个事件，它的“现场”就在事件格里原地撑开（一次一个）：
// 那一刻的年龄、身份、财富、家庭、正在坚持的主线，以及当时 / 后来两组来源。
// 点一段主线，在它起始那一年的事件格里撑开主线详情，并高亮它覆盖的事件。
// 宽度和其他标签页一致。
//
// 所有现场都在 HTML 里（搜索引擎和不开 JavaScript 的读者靠 #锚点 看到每一个），
// 脚本只负责展开、键盘和高亮。
import TabLayout from '../../layouts/TabLayout.astro';
import { getPeople } from '../../lib/people-data';
import { PEOPLE_PATH } from '../../lib/people';
import SourceCard from './SourceCard.astro';
import { VALENCES, dotDate } from '../../lib/life-grid';
import { SITE_URL, siteTitle } from '../../lib/site';
import '../../styles/people.css';
import '../../styles/life-grid.css';

interface Props { slug: string }

const { slug } = Astro.props;
const { people, grids } = await getPeople();
const g = grids.find((x) => x.slug === slug)!;
const pages = new Set([...people.map((p) => p.slug), ...grids.map((x) => x.slug)]);

const display = g.nameZh ?? g.name;
const L = g.lanes;
const D = g.dimensions.length;
const col = { year: 1, age: 2, lane: (i: number) => 3 + i, dim: (i: number) => 3 + L + i, events: 3 + L + D };
const row = (i: number) => i + 2;
const eventIndex = new Map(g.events.map((e, i) => [e.id, i]));
const arcsFrom = (i: number) => g.arcs.filter((a) => a.rowFrom === i);

const pageTitle = siteTitle(`${g.nameZh ? `${g.nameZh}（${g.name}）` : g.name} · 人物`);
const pageDesc = `${display}${g.role ? `：${g.role}` : ''}。${g.lifeText ? `${g.lifeText.split(' · ')[0]}，` : ''}${g.events.length} 个事件、${g.arcs.length} 条人生主线，按年份排开，每件事都能回到当时的现场。`;
const canonical = `${SITE_URL}${PEOPLE_PATH}/${g.slug}`;
---

<TabLayout tab="people" showScore={false} mainClass="life-page" title={pageTitle} description={pageDesc} canonicalUrl={canonical} ogUrl={canonical}>
  <script is:inline>document.documentElement.classList.add('lg-js');</script>
  <a class="person-back" href={PEOPLE_PATH}>← 人物 / People</a>

  <header class="lg-head">
    <div class="lg-who">
      <div class="lg-name">
        <h1>{display}</h1>
        {g.nameZh && <span class="lg-alt">{g.name}</span>}
      </div>
      <div class="lg-sub">
        {g.lifeText && <span class="lg-life">{g.lifeText}</span>}
        {g.role && <span>{g.role}</span>}
      </div>
    </div>
    <dl class="lg-facts">
      {g.facts.map((f) => <div><dd>{f.value}</dd><dt>{f.label}</dt></div>)}
    </dl>
  </header>

  {(g.labels.length > 0 || g.take) && (
    <div class="lg-about">
      {g.labels.length > 0 && (
        <ul class="lg-labels" aria-label="别人怎么叫他">
          {g.labels.map((l) => (
            <li>
              {l.url ? <a href={l.url} target="_blank" rel="noopener nofollow">「{l.text}」</a> : <span>「{l.text}」</span>}
              {l.by && <small>{l.by}</small>}
            </li>
          ))}
        </ul>
      )}
      {g.take && <p class="lg-take"><b>蜗牛说</b>{g.take}</p>}
    </div>
  )}

  <div class="lg-legend">
    {g.valences.map((v) => <span><i class={`lg-dot v-${v}`}></i>{VALENCES[v]}</span>)}
    <span class="lg-note">
      {[g.hasEstimate && '标「估」的是档位估算', '点事件展开当时的现场，点主线看那段坚持'].filter(Boolean).join(' · ')}<span class="lg-keys"> · ↑↓ 或 j / k 切换事件，Esc 收起</span>
    </span>
  </div>

  <section class="lg-ledger" aria-label={`${display}的人生网格`}>
    <div class="lg-grid" style={`--lanes:${L};--dims:${D}`} data-grid>
      <div class="lg-hd" style={`grid-column:${col.year}`}>年份</div>
      <div class="lg-hd lg-hd-age" style={`grid-column:${col.age}`}>岁</div>
      <div class="lg-hd lg-hd-lanes" style={`grid-column:${col.lane(0)} / span ${L}`}>主线<span class="lg-hd-more"> · 越长越坚持</span></div>
      {g.dimensions.map((d, i) => <div class="lg-hd lg-hd-dim" style={`grid-column:${col.dim(i)}`}>{d.label}</div>)}
      <div class="lg-hd" style={`grid-column:${col.events}`}>事件 · 点开看现场</div>

      {g.rows.map((r, i) => (
        <>
          <div class:list={['lg-cell lg-yr', { 'is-fold': r.fold }]} style={`grid-row:${row(i)};grid-column:${col.year}`}>{r.label}{r.age !== null && <span class="lg-yr-age">{r.age}岁</span>}</div>
          <div class:list={['lg-cell lg-age', { 'is-fold': r.fold }]} style={`grid-row:${row(i)};grid-column:${col.age}`}>{r.age}</div>
          <div class:list={['lg-lanebg', { 'is-fold': r.fold }]} style={`grid-row:${row(i)};grid-column:${col.lane(0)} / span ${L}`}></div>
          {g.dimensions.map((_, j) => <div class:list={['lg-dimbg', { 'is-fold': r.fold }]} style={`grid-row:${row(i)};grid-column:${col.dim(j)}`}></div>)}
          <div class:list={['lg-cell lg-evs', { 'is-fold': r.fold }]} style={`grid-row:${row(i)};grid-column:${col.events}`}>
            {r.fold && <span class="lg-foldnote">{r.to > r.from ? `${r.to - r.from + 1} 年 · ` : ''}暂无记录事件</span>}

            {r.events.map((id) => {
              const i = eventIndex.get(id)!;
              const e = g.events[i];
              const prev = g.events[i - 1];
              const next = g.events[i + 1];
              const hasLater = Boolean(e.laterText) || e.later.length > 0;
              return (
                <>
                  <a class={`lg-ev i${e.importance} v-${e.valence}`} href={`#${e.id}`} data-ev={e.id} aria-controls={e.id} aria-expanded="false">
                    <span class="lg-dot"></span><span class="lg-md">{e.shortDate}</span><span class="lg-tt">{e.title}</span>
                  </a>
                  <div class={`lg-scene v-${e.valence}`} id={e.id} data-scene data-event role="region" aria-label={e.title}>
                    <div class="sc-bar">
                      <div class="sc-meta">
                        <span>{e.dateText}</span>
                        {e.age && <span>{e.age}</span>}
                        <span class="sc-pill"><i class="lg-dot"></i>{e.valenceLabel}</span>
                        {e.place && <span class="sc-place">{e.place}</span>}
                      </div>
                      <nav class="sc-nav" aria-label="切换事件">
                        {prev ? <a href={`#${prev.id}`} aria-label={`上一个事件：${prev.title}`}>↑</a> : <span></span>}
                        {next ? <a href={`#${next.id}`} aria-label={`下一个事件：${next.title}`}>↓</a> : <span></span>}
                        <a href="#" data-close aria-label="收起">×</a>
                      </nav>
                    </div>

                    <dl class="sc-moment">
                      {e.moment.map((m) => <div><dt>{m.label}{m.estimate && ' · 估'}</dt><dd>{m.value ?? '—'}</dd></div>)}
                      <div class="is-wide">
                        <dt>正在坚持</dt>
                        <dd>
                          {e.arcs.length > 0
                            ? e.arcs.map((a) => <a class={`sc-chip k-${a.color}`} href={`#${a.id}`}>{a.label} · 第{a.year}年</a>)
                            : <span class="sc-faint">还没有开始</span>}
                        </dd>
                      </div>
                    </dl>

                    <div class="sc-tabs" role="tablist">
                      <button type="button" class="sc-tab" role="tab" data-tab="then" aria-selected="true">当时<span>{e.then.length}</span></button>
                      {hasLater && <button type="button" class="sc-tab" role="tab" data-tab="later" aria-selected="false">后来<span>{e.later.length}</span></button>}
                    </div>

                    <section class="sc-tabbody is-on" data-tabbody="then">
                      <h3 class="sc-tabhead">当时</h3>
                      {e.thenText && <p class="sc-narr">{e.thenText}</p>}
                      {e.steps.length > 0 && <ol class="sc-steps">{e.steps.map((s) => <li><span>{s.date}</span>{s.text}</li>)}</ol>}
                      {e.sides.length > 0 && <div class="sc-sides">{e.sides.map((s) => <div><b>{s.who}</b><p>{s.text}</p></div>)}</div>}
                      {e.then.length > 0
                        ? <div class="sc-snaps">{e.then.map((s) => <SourceCard source={s} />)}</div>
                        : <p class="sc-hint">没有找到事发当时的公开报道。这段叙述依据事后的回忆和报道还原，出处在“后来”。</p>}
                    </section>

                    {hasLater && (
                      <section class="sc-tabbody" data-tabbody="later">
                        <h3 class="sc-tabhead">后来</h3>
                        {e.laterText && <p class="sc-narr">{e.laterText}</p>}
                        <div class="sc-snaps">{e.later.map((s) => <SourceCard source={s} />)}</div>
                      </section>
                    )}

                    {e.commentary && <div class="sc-block sc-take"><div class="sc-k">蜗牛说</div><p>{e.commentary}</p></div>}
                    {e.people.length > 0 && (
                      <div class="sc-block">
                        <div class="sc-k">一起出现的人</div>
                        <p class="sc-people">{e.people.map((x) => (pages.has(x.slug) ? <a href={`${PEOPLE_PATH}/${x.slug}`}>{x.name}</a> : <span>{x.name}</span>))}</p>
                      </div>
                    )}
                    {e.links.length > 0 && (
                      <div class="sc-block">
                        <div class="sc-k">前因后果</div>
                        <ul class="sc-list">{e.links.map((l) => <li><a href={`#${l.id}`}><span>{l.title}</span>{l.note && <small>{l.note}</small>}</a></li>)}</ul>
                      </div>
                    )}
                  </div>
                </>
              );
            })}

            {arcsFrom(i).map((a) => (
              <div class={`lg-scene is-arc k-${a.color}`} id={a.id} data-scene data-arc-scene={a.id} role="region" aria-label={a.label}>
                <div class="sc-bar">
                  <div class="sc-meta"><span class="sc-arc-name">{a.label}</span><span>{a.span}</span>{a.role && <span>{a.role}</span>}</div>
                  <nav class="sc-nav"><a href="#" data-close aria-label="收起">×</a></nav>
                </div>
                <div class="sc-dur">{a.duration}</div>
                {a.summary && <p class="sc-narr">{a.summary}</p>}
                <div class="sc-k">这段时间里的 {a.events.length} 个事件</div>
                <ul class="sc-list">
                  {a.events.map((id) => {
                    const e = g.events[eventIndex.get(id)!];
                    return <li><a href={`#${e.id}`}><i class={`lg-dot v-${e.valence}`}></i><span class="sc-md">{dotDate(e.date, e.prec === 'day' ? 'month' : e.prec)}</span><span>{e.title}</span></a></li>;
                  })}
                </ul>
                {a.sources.length > 0 && <div class="sc-snaps">{a.sources.map((s) => <SourceCard source={s} />)}</div>}
              </div>
            ))}
          </div>
        </>
      ))}

      {g.arcs.map((a) => (
        <a
          class:list={['lg-arc', `k-${a.color}`, { 'is-short': a.short, 'is-open': !a.end }]}
          href={`#${a.id}`}
          data-arc={a.id}
          data-events={a.events.join(' ')}
          style={`grid-column:${col.lane(a.lane)};grid-row:${row(a.rowFrom)} / ${row(a.rowTo) + 1}`}
          aria-label={`${a.label}，${a.duration}`}
        >
          <span class="lg-arc-lab">
            <span class="lg-arc-nm">{a.label}</span>
            <span class="lg-arc-du">{a.duration.endsWith('+') ? <>{a.duration.slice(0, -1)}<br />至今</> : a.duration}</span>
          </span>
        </a>
      ))}

      {g.dimensions.map((d, j) => d.states.map((s) => (
        <div class="lg-st" style={`grid-column:${col.dim(j)};grid-row:${row(s.rowFrom)} / ${row(s.rowTo) + 1}`}>
          <div class="lg-st-in">
            {s.label}{s.estimate && <span class="lg-est" title="档位估算">估</span>}
            {s.note && <span class="lg-st-note">{s.note}</span>}
          </div>
        </div>
      )))}
    </div>
  </section>
</TabLayout>

<script>
  // 展开现场：点事件 / 主线 / 现场里的链接都走这里，一次只展开一个，地址栏的
  // #锚点 跟着变，可以分享，也能用浏览器的后退。再点一次已展开的事件就收起。
  // 不开 JavaScript 时靠 CSS 的 :target 展开。
  //
  // 站点用 Astro 的 ClientRouter：页面之间是局部替换，这个脚本只执行一次。
  // 所以点击、键盘、后退的监听挂在 document 上（点击用捕获阶段，抢在路由
  // 之前处理本页锚点），每次进入页面（astro:page-load）再初始化当前页。
  const STICKY = 48; // 吸顶表头的高度，滚动定位时让开它
  let current = '';

  const gridEl = () => document.querySelector<HTMLElement>('[data-grid]');
  const sceneOf = (grid: HTMLElement, id: string) =>
    id ? grid.querySelector<HTMLElement>(`[data-scene]#${CSS.escape(id)}`) : null;
  /** 现场对应的那一行：事件按钮，或主线起始年的事件格。 */
  const anchorOf = (grid: HTMLElement, id: string) =>
    grid.querySelector<HTMLElement>(`[data-ev="${CSS.escape(id)}"]`) ?? sceneOf(grid, id)?.parentElement ?? null;

  function focusArc(grid: HTMLElement, id: string | null) {
    grid.classList.toggle('is-focus', Boolean(id));
    const arcs = Array.from(grid.querySelectorAll<HTMLElement>('[data-arc]'));
    const inside = new Set((arcs.find((a) => a.dataset.arc === id)?.dataset.events ?? '').split(' '));
    arcs.forEach((a) => a.classList.toggle('is-on', a.dataset.arc === id));
    grid.querySelectorAll<HTMLElement>('[data-ev]').forEach((e) => e.classList.toggle('in-arc', inside.has(e.dataset.ev ?? '')));
  }

  /**
   * 展开 id（空字符串 = 全部收起）。keep：被点的那一行留在屏幕原来的位置
   * （上面的现场收起时页面不会跳）；否则把展开的那一行滚到表头下面。
   */
  function open(id: string, keep: HTMLElement | null) {
    const grid = gridEl();
    if (!grid) return;
    const scene = sceneOf(grid, id);
    const before = keep?.getBoundingClientRect().top ?? null;
    current = scene ? id : '';
    grid.querySelectorAll<HTMLElement>('[data-scene]').forEach((s) => s.classList.toggle('is-on', s === scene));
    grid.querySelectorAll<HTMLElement>('[data-ev]').forEach((b) => {
      const on = b.dataset.ev === current;
      b.classList.toggle('is-sel', on);
      b.setAttribute('aria-expanded', String(on));
    });
    focusArc(grid, scene?.dataset.arcScene ?? null);
    if (keep && before !== null) {
      scrollBy(0, keep.getBoundingClientRect().top - before);
    } else if (scene) {
      const top = anchorOf(grid, current)!.getBoundingClientRect().top;
      if (top < STICKY || top > innerHeight * 0.45) scrollTo({ top: scrollY + top - STICKY - 12 });
    }
  }

  function go(id: string, keep: HTMLElement | null) {
    const url = id ? `#${id}` : location.pathname + location.search;
    history.pushState(null, '', url);
    open(id, keep);
  }

  document.addEventListener('click', (ev) => {
    const grid = gridEl();
    if (!grid || ev.defaultPrevented || ev.button !== 0 || ev.metaKey || ev.ctrlKey || ev.shiftKey || ev.altKey) return;
    const target = ev.target as HTMLElement;
    if (!grid.contains(target)) return;
    const tab = target.closest<HTMLElement>('[data-tab]');
    if (tab) {
      const scene = tab.closest('[data-scene]')!;
      scene.querySelectorAll('[data-tab]').forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
      scene.querySelectorAll<HTMLElement>('[data-tabbody]').forEach((b) => b.classList.toggle('is-on', b.dataset.tabbody === tab.dataset.tab));
      return;
    }
    const link = target.closest<HTMLAnchorElement>('a[href^="#"]');
    if (!link) return;
    ev.preventDefault();
    if (link.hasAttribute('data-close')) {
      const anchor = anchorOf(grid, current);
      go('', null);
      const top = anchor?.getBoundingClientRect().top;
      if (top !== undefined && top < STICKY) scrollBy(0, top - STICKY - 12);
      return;
    }
    const id = link.getAttribute('href')!.slice(1);
    if (!sceneOf(grid, id)) return;
    // 网格里的事件：原地展开或收起，这一行不动；主线：在起始那一年展开；现场里的链接：跳过去
    if (link.dataset.ev) go(id === current ? '' : id, link);
    else if (link.dataset.arc) go(id === current ? '' : id, null);
    else go(id, null);
  }, true);

  document.addEventListener('mouseover', (ev) => {
    const grid = gridEl();
    const a = grid && (ev.target as HTMLElement).closest<HTMLElement>('[data-arc]');
    if (grid && a) focusArc(grid, a.dataset.arc ?? null);
  });
  document.addEventListener('mouseout', (ev) => {
    const grid = gridEl();
    const a = grid && (ev.target as HTMLElement).closest<HTMLElement>('[data-arc]');
    if (grid && a && !a.contains(ev.relatedTarget as Node)) focusArc(grid, sceneOf(grid, current)?.dataset.arcScene ?? null);
  });

  addEventListener('keydown', (ev) => {
    const grid = gridEl();
    if (!grid || /input|textarea|select/i.test((ev.target as HTMLElement).tagName) || ev.metaKey || ev.ctrlKey || ev.altKey) return;
    if (ev.key === 'Escape' && current) { go('', null); return; }
    const ids = Array.from(grid.querySelectorAll<HTMLElement>('[data-ev]')).map((b) => b.dataset.ev!);
    const i = ids.indexOf(current);
    const step = ev.key === 'j' || ev.key === 'ArrowDown' ? 1 : ev.key === 'k' || ev.key === 'ArrowUp' ? -1 : 0;
    if (!step || i < 0 || !ids[i + step]) return;
    ev.preventDefault();
    go(ids[i + step], null);
  });

  addEventListener('popstate', () => {
    if (gridEl()) open(decodeURIComponent(location.hash.slice(1)), null);
  });

  document.addEventListener('astro:page-load', () => {
    if (!gridEl()) return;
    document.documentElement.classList.add('lg-js');
    current = '';
    open(decodeURIComponent(location.hash.slice(1)), null);
  });
</script>
