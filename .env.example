SUPABASE_URL=https://your-project.supabase.co
# Use a key with read access to the build tables. Keep secret keys server-side.
SUPABASE_BUILD_KEY=sb_publishable_your-key

# Separate community project. Disabled until migrations and email settings are ready.
PUBLIC_COMMUNITY_ENABLED=false
PUBLIC_COMMUNITY_SUPABASE_URL=https://your-community-project.supabase.co
PUBLIC_COMMUNITY_SUPABASE_KEY=sb_publishable_your-community-key
# Aliyun Supabase also accepts its legacy anon JWT here, never the service_role key.
# Optional in closed testing; configure Auth CAPTCHA before public signup.
PUBLIC_COMMUNITY_TURNSTILE_KEY=
# Development browser tests only. Mock credentials are rejected in production.
PUBLIC_COMMUNITY_MOCK_TEST=false
