{
  "name": "ahaindex2-game-server",
  "version": "1.0.0",
  "private": true,
  "description": "西湖飞车联机服务端：自动匹配 2-4 人房间，服务器判定检查点和完赛，成绩写入 Supabase",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "test": "node --test test/*.test.js && node test/sim.js",
    "test:unit": "node --test test/*.test.js",
    "test:sim": "node test/sim.js",
    "export:track": "node --import ./scripts/three-alias.mjs scripts/export-xihu-track.mjs",
    "test:xihu": "node test/xihu-e2e.js"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.24",
    "@colyseus/schema": "^5.0.43",
    "@colyseus/sdk": "^0.18.9",
    "@colyseus/ws-transport": "^0.18.4",
    "express": "^5.3.0"
  }
}
